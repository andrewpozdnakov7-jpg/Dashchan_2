<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Slooop.PhotoFileOptions" parent="Theme.Material3.Dark.NoActionBar">
        <item name="themeEnginePreserveColors">true</item>
        <item name="android:forceDarkAllowed">false</item>
        <item name="colorPrimary">#A8C7FA</item>
        <item name="colorOnPrimary">#062E60</item>
        <item name="colorSecondary">#A8C7FA</item>
        <item name="colorOnSecondary">#062E60</item>
        <item name="colorSurface">#28292E</item>
        <item name="colorOnSurface">#E3E3E3</item>
        <item name="colorOnSurfaceVariant">#B4B6BD</item>
        <item name="android:colorAccent">#A8C7FA</item>
        <item name="bottomSheetDialogTheme">@style/PhotoFileOptionsDialogTheme</item>
    </style>
    <style name="PhotoFileOptionsDialogTheme" parent="ThemeOverlay.Material3.BottomSheetDialog">
        <item name="enableEdgeToEdge">true</item>
        <item name="bottomSheetStyle">@style/Widget.Slooop.PhotoFileOptionsSheet</item>
        <item name="android:backgroundDimAmount">0.24</item>
    </style>
    <style name="Widget.Slooop.PhotoFileOptionsSheet" parent="Widget.Material3.BottomSheet.Modal">
        <item name="backgroundTint">#28292E</item>
        <item name="paddingBottomSystemWindowInsets">false</item>
        <item name="paddingTopSystemWindowInsets">false</item>
    </style>
</resources>
