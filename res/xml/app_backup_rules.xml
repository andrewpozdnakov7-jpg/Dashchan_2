<?xml version="1.0" encoding="utf-8"?>
<!-- Android 11. Settings contain proxy/passcode credentials; databases contain
     cookies and browsing data; files/root also contain drafts and WebView state.
     Exclude entire domains, including journals and future files, not just named
     JSON files. The user-initiated BackupManager ZIP export is independent. -->
<full-backup-content>
	<exclude domain="root" path="." />
	<exclude domain="file" path="." />
	<exclude domain="database" path="." />
	<exclude domain="sharedpref" path="." />
	<exclude domain="external" path="." />
	<exclude domain="device_root" path="." />
	<exclude domain="device_file" path="." />
	<exclude domain="device_database" path="." />
	<exclude domain="device_sharedpref" path="." />
</full-backup-content>
