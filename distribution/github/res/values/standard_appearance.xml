<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Standard.Dialog" parent="">
        <item name="android:dialogPreferredPadding">24dp</item>
        <item name="android:buttonBarButtonStyle">@style/Widget.Standard.DialogButton</item>
    </style>
    <style name="Widget.Standard.DialogButton" parent="@android:style/Widget.Material.Button.Borderless">
        <item name="android:minHeight">48dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:singleLine">false</item>
    </style>
    <style name="Theme.Standard.Popup" parent="">
        <!-- ThemeEngine needs this marker to attach the surface and motion policy. -->
        <item name="isPopup">true</item>
        <item name="standardPopupAppearance">true</item>
        <item name="android:textAppearanceLargePopupMenu">@style/TextAppearance.Standard.Menu</item>
        <item name="android:textAppearanceSmallPopupMenu">@style/TextAppearance.Standard.Menu</item>
        <item name="android:listPreferredItemHeightSmall">48dp</item>
        <item name="android:listPreferredItemPaddingStart">16dp</item>
        <item name="android:listPreferredItemPaddingEnd">16dp</item>
        <item name="android:popupMenuStyle">@style/Widget.Standard.Popup</item>
        <item name="android:listPopupWindowStyle">@style/Widget.Standard.Popup</item>
        <item name="android:actionOverflowMenuStyle">@style/Widget.Standard.Popup.Overflow</item>
        <item name="android:dropDownListViewStyle">@style/Widget.Standard.Popup.List</item>
    </style>
    <style name="Theme.Standard.Popup.Static" parent="@style/Theme.Standard.Popup">
        <item name="android:popupMenuStyle">@style/Widget.Standard.Popup.Static</item>
        <item name="android:listPopupWindowStyle">@style/Widget.Standard.Popup.Static</item>
        <item name="android:actionOverflowMenuStyle">@style/Widget.Standard.Popup.Static.Overflow</item>
    </style>
    <style name="Widget.Standard.Popup" parent="@style/Widget.Motion.Popup">
        <!-- Padding is known before PopupWindow measures and places the surface. -->
        <item name="android:popupBackground">@drawable/standard_popup_background</item>
    </style>
    <style name="Widget.Standard.Popup.List" parent="@android:style/Widget.Material.ListView.DropDown">
        <item name="android:paddingTop">0dp</item>
        <item name="android:paddingBottom">0dp</item>
    </style>
    <style name="Widget.Standard.Popup.Overflow" parent="@style/Widget.Standard.Popup">
        <item name="android:overlapAnchor">true</item>
        <item name="android:dropDownVerticalOffset">-4dp</item>
    </style>
    <style name="Widget.Standard.Popup.Static" parent="@style/Widget.Standard.Popup">
        <item name="android:popupEnterTransition">@null</item>
        <item name="android:popupExitTransition">@null</item>
    </style>
    <style name="Widget.Standard.Popup.Static.Overflow" parent="@style/Widget.Standard.Popup.Static">
        <item name="android:overlapAnchor">true</item>
        <item name="android:dropDownVerticalOffset">-4dp</item>
    </style>
    <style name="TextAppearance.Standard.Menu" parent="@android:style/TextAppearance.Material.Widget.PopupMenu.Large">
        <item name="android:textSize">14sp</item>
        <item name="android:lineHeight">20sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
    </style>
</resources>
