<?xml version="1.0" encoding="utf-8"?>
<com.mishiranu.dashchan.widget.AttachmentMediaTile xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content" android:layout_height="wrap_content">
    <com.mishiranu.dashchan.widget.AttachmentView android:id="@id/thumbnail"
        android:layout_width="match_parent" android:layout_height="match_parent" />
    <TextView android:id="@id/attachment_info" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:paddingStart="8dp" android:paddingEnd="8dp"
        android:paddingTop="6dp" android:paddingBottom="6dp" android:textSize="11sp" android:textColor="#FFFFFFFF" />
    <View android:id="@id/attachment_click" android:layout_width="match_parent" android:layout_height="match_parent"
        android:background="?android:attr/selectableItemBackground" />
</com.mishiranu.dashchan.widget.AttachmentMediaTile>
