<?xml version="1.0" encoding="utf-8"?>
<set xmlns:android="http://schemas.android.com/apk/res/android" android:shareInterpolator="true"
    android:interpolator="@interpolator/motion_standard" android:duration="180">
    <alpha android:fromAlpha="1" android:toAlpha="0" />
    <scale android:fromXScale="1" android:toXScale="0.96"
        android:fromYScale="1" android:toYScale="0.96"
        android:pivotX="50%" android:pivotY="50%" />
    <translate android:fromYDelta="0" android:toYDelta="3%" />
</set>
